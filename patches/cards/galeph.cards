*---------------- Galeph Cards ------------------------------        
FILI ' pyth05-test.epio | EPIO '
FILO ' galeph-test.epio | EPIO '   
DATE ${dategeom}          ! Put 90 if 1990 geometry      
* TIME 100
* FDBA ' adbs314.daf | DAF '         
NEVT  1000
DEBU  1 10 1
*       DATA TPRIN /'VDET','ITC ','TPC ','ECAL','LCAL','SATR','HCAL'
*     &           ,'MUON','SICA','UNDF'
*     &           ,'TRIG','RDST','UNDF','OUTP','INPU','KINE','TREL'
*     &           ,'DRAW','GEOM','PART'/
*
PRINT 'INPU' 'OUTP' 'KINE' 'GEOM'
DISPLAY 0 /          
TPCSIM   
PROC   'DIGI' 'HITS'  'TRAC'  'TRIG'      
SETS  'VDET' 'ITC ' 'TPC ' 'ECAL' 'HCAL' 'MUON' 'LCAL' 'SICA'        
*------------------------------------------------------------        
ENDQ
