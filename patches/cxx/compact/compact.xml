<lccdd>
  <info name="aleph_from_geant3"
        title="ALEPH Geometry import from Geant3"
        author="Markus Frank"
        url="https://alephwww.cern.ch"
        status="development"
        version="1.0">
  </info>

  <debug>
    <type name="includes"      value="1"/>
    <type name="constants"     value="0"/>
    <type name="isotopes"      value="0"/>
    <type name="elements"      value="0"/>
    <type name="materials"     value="0"/>
    <type name="readouts"      value="1"/>
    <type name="limits"        value="1"/>
    <type name="segmentations" value="1"/>
    <type name="surfaces"      value="0"/>
    <type name="detelements"   value="1"/>
  </debug>

  <define>
    <constant name="world_size"              value="20*m"/>
    <constant name="world_x"                 value="world_size"/>
    <constant name="world_y"                 value="world_size"/>
    <constant name="world_z"                 value="world_size"/>
  </define>

  <includes>
    <file ref="elements.xml"/>
    <file ref="materials.xml"/>
    <file ref="AlephConstants.xml"/>
    <file ref="AlephMaterials.xml"/>
    <file ref="AlephVis.xml"/>
    <!-- This include requires a special plugin  -->
    <file ref="AlephEnhancements.xml"/>
  </includes>

  <detectors>
    <detector id="1000" name="ALEPH" type="DD4hep_Geant3Detector" vis="Vis_ALEPH">
      <volume name="ALEF"/>
    </detector>
  </detectors>

  <regions>
    <region name="VDETregion" eunit="MeV" lunit="mm" cut="0.001" threshold="0.001">
      <limitsetref name="VDET"/>
    </region>
  </regions>

  <readouts>
    <readout name="VDET">
      <id>system:8,barrel:3,layer:4,module:14,sensor:2,side:32:-2,strip:20</id>
    </readout>        
  </readouts>

  <limits>
    <limitset name="TPC">
      <limit name="step_length_max" particles="*" value="5" unit="mm" />
      <limit name="ekin_min"  particles="*" value="0.01" unit="MeV" />
      <limit name="range_min" particles="*" value="5.0" unit="mm" />
    </limitset>
    <limitset name="VDET">
      <limit name="ekin_min" particles="*" value="0.01" unit="MeV" />
    </limitset>
  </limits>

  <fields>
    <field name="GlobalSolenoid" type="solenoid" 
	   inner_field="1.5*tesla"
	   outer_field="-0.5*tesla"
	   zmax="365.4*cm"
	   outer_radius="(248+297.3)/2.0*cm">
    </field>
  </fields>

  <plugins>
    <include ref="AlephReadout.xml"/>
  </plugins>

</lccdd>
