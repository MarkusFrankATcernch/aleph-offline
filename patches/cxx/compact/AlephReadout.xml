<lccdd>

  <geometry open="false" close="false"/>

  <includes>
    <file ref="AlephPlugins.xml"/>
  </includes>

  <sensitive_detectors>
    <sd name="VDET" type="tracker" verbose="true" limits="VDET" hits_collection="VDET"/>
  </sensitive_detectors>

  <plugins>
    <plugin name="DD4hep_DetectorDump">
      <argument value="-volids"/>
    </plugin>
  </plugins>

</lccdd>
